{
  "name": "photo-thematic-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "data:bicycles": "node scripts/data/build-bicycles.ts",
    "data:plateau": "node --use-env-proxy scripts/plateau/build-catalog.ts",
    "data:grids": "node --import ./scripts/bake/register.ts scripts/bake/index.ts",
    "data:grids:pile": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/bake/register.ts scripts/bake/pileTrial.ts"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.4",
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "exceljs": "4.4.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
